//Microsoft Visual C++ generated resource script.
#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#ifndef APSTUDIO_INVOKED
#include "targetver.h"
#endif
#define APSTUDIO_HIDDEN_SYMBOLS
#include "windows.h"
#undef APSTUDIO_HIDDEN_SYMBOLS
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_KOR)
LANGUAGE 18, 1

IDI_HIDEPRO       ICON         "hidepro.ico"
IDI_SMALL         ICON         "small.ico"

IDC_HIDEPRO MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Hide All",            IDM_HIDE_ALL
        MENUITEM "Show All",            IDM_SHOW_ALL
        MENUITEM SEPARATOR
        MENUITEM "Exit",                IDM_EXIT
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "Auto Start",          IDM_AUTORUN
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "About...",            IDM_ABOUT
    END
END

IDC_HIDEPRO ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END

IDD_ABOUTBOX DIALOGEX 0, 0, 200, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About HidePro"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON            IDI_HIDEPRO,IDC_STATIC,14,14,21,20
    LTEXT           "HidePro v1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Window Hider",IDC_STATIC,42,26,114,8
    LTEXT           "Copyright (C) 2026",IDC_STATIC,42,38,114,8
    DEFPUSHBUTTON   "OK",IDOK,140,59,50,14,WS_GROUP
END

IDD_MAINDLG DIALOGEX 0, 0, 380, 280
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "HidePro - Window Hider"
FONT 9, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Registered Windows",IDC_STATIC,7,7,366,200
    CONTROL         "",IDC_LIST_WINDOWS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,14,20,352,180

    GROUPBOX        "Add Window",IDC_STATIC,7,210,180,40
    PUSHBUTTON      "Mouse",IDC_BTN_ADD_MOUSE,14,223,52,20
    PUSHBUTTON      "Process",IDC_BTN_ADD_PROCESS,70,223,52,20
    PUSHBUTTON      "Title",IDC_BTN_ADD_TITLE,126,223,52,20

    GROUPBOX        "Manage",IDC_STATIC,193,210,180,40
    PUSHBUTTON      "Remove",IDC_BTN_REMOVE,200,223,40,20
    PUSHBUTTON      "Hide",IDC_BTN_HIDE,244,223,40,20
    PUSHBUTTON      "Show",IDC_BTN_SHOW,288,223,40,20
    PUSHBUTTON      "Hide All",IDC_BTN_HIDE_ALL,332,223,40,20

    AUTOCHECKBOX    "Start with Windows",IDC_CHK_AUTORUN,14,257,90,12
    LTEXT           "",IDC_STATIC_STATUS,110,257,100,12
END

IDD_PROCESSDLG DIALOGEX 0, 0, 300, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select from Process"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "Windows:",IDC_STATIC,7,7,100,10
    CONTROL         "",IDC_LIST_PROCESS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,20,286,225
    PUSHBUTTON      "Refresh",IDC_BTN_REFRESH,7,250,50,20
    DEFPUSHBUTTON   "Select",IDOK,189,250,50,20
    PUSHBUTTON      "Cancel",IDCANCEL,243,250,50,20
END

IDD_WINDOWDLG DIALOGEX 0, 0, 350, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select by Title"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "Filter:",IDC_STATIC,7,9,25,10
    EDITTEXT        IDC_EDIT_FILTER,35,7,250,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Search",IDC_BTN_FILTER,290,7,50,14
    CONTROL         "",IDC_LIST_ALLWINDOWS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,27,336,240
    DEFPUSHBUTTON   "Select",IDOK,239,275,50,18
    PUSHBUTTON      "Cancel",IDCANCEL,293,275,50,18
END

